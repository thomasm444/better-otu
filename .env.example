# Supabase — Project Settings → API

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ or ship it to the browser.
# New-style projects: sb_secret_...  |  Legacy: the service_role JWT (eyJ...)
SUPABASE_SERVICE_KEY=

# Database password (Project Settings → Database). Only needed for direct psql access.
SUPABASE_DATABASE_PASSWORD=

# Browser-safe key used by the Next.js app. New-style: sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
